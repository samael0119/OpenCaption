#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
out=evaluation/results/v020-round3/preflight
mkdir -p "$out"
[[ ! -e "$out/report.json" ]] || { echo 'Preflight completed; inspect checkpoint' >&2; exit 3; }
flock -n evaluation/results/v020-independent/model.lock \
  systemd-run --user --scope --quiet --collect \
    -p MemoryHigh=384M -p MemoryMax=512M -p MemorySwapMax=0 \
    timeout --signal=TERM --kill-after=10s 60s \
    /home/hyh/Tools/litert/litert-venv/bin/python evaluation/v020_round3_preflight.py \
    >"$out/preflight.log" 2>&1
